{
  "manifest_version": 3,
  "name": "Bhagavad Gita New Tab",
  "version": "1.0",
  "description": "Display a verse from the Bhagavad Gita on every new tab",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
